# Copy this file to .env

# --- Multilogin X ---
# Recommended: an automation token (Multilogin app > Settings / API docs)
MLX_TOKEN=
# Or sign in with your account details instead of a token
# MLX_EMAIL=you@example.com
# MLX_PASSWORD=your_password

# Folder and profile IDs from the Multilogin app (one window per profile)
MLX_FOLDER_ID=
MLX_PROFILE_IDS=profile-id-1,profile-id-2,profile-id-3,profile-id-4,profile-id-5

# --- Website ---
# The page every window opens on start
START_URL=https://example.com

# --- Watcher ---
MATCH_STRING="Hello world"
# "html" = full page source, "text" = visible text only
MATCH_IN=html
POLL_MS=1000

# Bright Data proxies are set on each Multilogin profile (not here). Per profile use:
#   Type: HTTP   Host: brd.superproxy.io   Port: 44445
#   Username: brd-customer-<customer_id>-zone-<zone>-ip-<one of your IPs>
#   Password: <zone password>
